{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "sourceMap": true,
    "outDir": "built/cjs",
    "rootDir": "./lib",
    "declaration": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "noImplicitAny": false,
    "types": ["node", "mocha"]
  },
  "exclude": [
    "node_modules",
    "built",
    "specs",
    "example",
    "playground.*"
  ]
}
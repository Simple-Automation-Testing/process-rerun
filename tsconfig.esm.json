{
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "node",
    "target": "ESNext",
    "sourceMap": true,
    "outDir": "built/esm",
    "rootDir": "./lib",
    "declaration": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "types": [
      "node",
      "mocha"
    ]
  },
  "exclude": [
    "node_modules",
    "built",
    "specs",
    "example",
    "playground.*"
  ]
}